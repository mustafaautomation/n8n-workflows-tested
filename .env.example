# Environment the workflows read through $env (n8n needs N8N_BLOCK_ENV_ACCESS_IN_NODE=false).
# CI points these at mock/server.mjs. Never commit real values.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/incoming/webhook
SHEETS_API_BASE=https://sheets.googleapis.com
SHEET_ID=your-spreadsheet-id
HEALTH_TARGETS=https://example.com/health,https://api.example.com/status
